# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures dir contains memory dumps that cannot be used by other machines
/[Mm]emoryCaptures/

# Recordings dir contains recordings made by Unity
/[Rr]ecordings/

# Asset server cache
/[Aa]sset[Ss]erver[Cc]ache/

# Core Temp dir contains temp files generated by Unity
/[Cc]ore[Tt]emp/

# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Visual Studio / VS Code
.vscode/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated serialization files
/[Aa]ssets/[Aa]sync[Tt]extures/

# Asset store / crash reports
sysinfo.txt
*.stackdump

# Crashlytics
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app
